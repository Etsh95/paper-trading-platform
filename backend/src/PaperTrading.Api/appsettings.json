{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Trading": {
    "InitialCash": 100000,
    "FeeRate": 0.001,
    "MaxQuoteAge": "00:00:10",
    "MaxOpenOrdersPerAccount": 100
  },
  "MarketData": {
    "Provider": "Binance",
    "BinanceStreamUrl": "wss://data-stream.binance.vision",
    "FallbackToMock": true,
    "FailuresBeforeFallback": 3
  },
  "Auth": {
    "Issuer": "paper-trading-api",
    "Audience": "paper-trading-client"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "SessionsPerMinutePerIp": 10,
    "OrdersPerSecondPerAccount": 10,
    "OrderBurstPerAccount": 20
  }
}
